# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# P0912_ECOMMERCE — Template de configuração de ambiente
# Copie este arquivo para .env e ajuste os valores conforme
# o seu ambiente (dev / teste / produção).
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# --- Servidor ---
APP_HOST=127.0.0.1
APP_PORT=8000
APP_VERSION=0.1.0
DEBUG=true

# --- Logs ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Raiz para artefatos de runtime (banco, logs, uploads) ---
# Caminho absoluto opcional. Quando definido e válido (existe,
# é diretório, gravável), substitui a raiz do repositório como
# destino de artefatos de runtime. Quando vazio, BASE_DIR (raiz
# do código) é usado de forma transparente.
# Exemplos:
#   PROJECT_ROOT=/home/aluno/uni7/dados-ecommerce
#   PROJECT_ROOT=C:\Users\aluno\dados-ecommerce
PROJECT_ROOT=

# --- Banco de Dados ---
# Aceita o placeholder ${PROJECT_ROOT}, substituído na carga pela
# raiz de runtime resolvida. Quando PROJECT_ROOT está vazio, o
# placeholder cai para BASE_DIR (raiz do repositório).
DATABASE_URL=sqlite:///${PROJECT_ROOT}/ecommerce.db

# --- JWT ---
# JWT_SECRET simples apenas para desenvolvimento local; em
# produção use um valor robusto gerado de forma criptográfica.
JWT_SECRET=secret
JWT_ALGORITHM=HS256
# Janela curta para viabilizar exercícios de expiração de token.
JWT_EXPIRATION_MINUTES=15

# --- Usuários demo (carga inicial via seed) ---
DEMO_USER_EMAIL=aluno@uni7.edu.br
DEMO_USER_PASSWORD=teste123
DEMO_USER_2_EMAIL=aluno2@uni7.edu.br
DEMO_USER_2_PASSWORD=teste456

# --- Gateway de pagamento ---
# Tempo (em segundos) do sleep que simula latência de
# comunicação externa em GatewayDePagamento.cobrar.
# Defina 0 em ambientes de carga/integração para destravar.
GATEWAY_DELAY_SECONDS=5
# Quando true, cobrar retorna False — habilita o caminho HTTP 402.
GATEWAY_FORCAR_FALHA=false

# --- CORS ---
# Lista vazia por default (UI e API são same-origin).
# Aceita CSV: CORS_ORIGINS=https://a.exemplo,https://b.exemplo
CORS_ORIGINS=

# --- Toggles de comportamento ---
# Quando true, requisições são limitadas por taxa.
RATE_LIMIT_ENABLED=false
# Quando true, a consulta de pedido por ID opera de forma
# global, sem aplicar filtro por dono.
PEDIDOS_CONSULTA_GLOBAL=true
# Quando true, o pedido é serializado em formato detalhado
# (schema com mais campos).
PEDIDOS_RESPOSTA_DETALHADA=true
